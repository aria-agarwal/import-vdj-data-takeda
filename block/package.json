{
  "name": "@platforma-takeda/takeda.import-vdj-takeda",
  "version": "1.6.5",
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "scripts": {
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json,vue}\"",
    "build": "shx rm -rf ./block-pack && block-tools pack",
    "do-pack": "shx rm -f *.tgz && block-tools pack && pnpm pack && shx mv *.tgz package.tgz"
  },
  "dependencies": {
    "@platforma-takeda/takeda.import-vdj-takeda.model": "workspace:*",
    "@platforma-takeda/takeda.import-vdj-takeda.ui": "workspace:*",
    "@platforma-takeda/takeda.import-vdj-takeda.workflow": "workspace:*",
    "@platforma-sdk/model": "catalog:"
  },
  "devDependencies": {
    "@platforma-sdk/block-tools": "catalog:",
    "shx": "catalog:"
  },
  "packageManager": "pnpm@9.14.4",
  "block": {
    "components": {
      "workflow": "@platforma-takeda/takeda.import-vdj-takeda.workflow/dist/tengo/tpl/main.plj.gz",
      "model": "@platforma-takeda/takeda.import-vdj-takeda.model/dist/model.json",
      "ui": "@platforma-takeda/takeda.import-vdj-takeda.ui/dist"
    },
    "meta": {
      "title": "Import-VDJ-Takeda",
      "logo": "file:../logos/block-logo.png",
      "url": "https://github.com/oneTakeda/11514-platforma-blocks-import-vdj-takeda",
      "docs": "https://docs.platforma.bio/guides/antibody-discovery/data-import/",
      "support": "mailto:support@milaboratories.com",
      "description": "Imports V(D)J sequencing data from various formats (MiXCR, immunoSeq, QIAseq, Cell Ranger, CSV, TSV) and normalizes it for downstream analysis in standardized pipelines.",
      "longDescription": "file:../docs/description.md",
      "changelog": "file:../CHANGELOG.md",
      "tags": [
        "upstream",
        "airr",
        "import"
      ],
      "organization": {
        "name": "Takeda",
        "url": "https://www.takeda.com/",
        "logo": "file:../logos/organization-logo.png"
      },
      "marketplaceRanking": 16900
    }
  }
}
